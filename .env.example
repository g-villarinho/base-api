# Environment
ENV=development

# Server
SERVER_PORT=5001
SERVER_HOST=localhost

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=baseproject
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_MAX_CONN=10
DATABASE_MAX_IDLE=5
DATABASE_MAX_LIFETIME=300s

# Rate Limit
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS (comma-separated for multiple values)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# URLs
API_BASE_URL=http://localhost:5001
APP_BASE_URL=http://localhost:3000

# Resend (Email)
RESEND_API_KEY=
RESEND_DOMAIN=
RESEND_TIMEOUT=10s

# Session
SESSION_SECRET=
SESSION_DURATION=168h
SESSION_TOKEN_SIZE=32
SESSION_COOKIE_NAME=_ba.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict

# Auth (password, magic_link, both)
AUTH_METHOD=password
